using UnityEngine;
using UnityEngine.InputSystem;

public class PlayerInventory : MonoBehaviour
{
    private int storedHealthKits = 0;
    private int healAmountPerKit = 25;
    private PlayerHealth playerHealth;

    private void Start()
    {
        playerHealth = GetComponent<PlayerHealth>();
    }

    public void PickupHealthKit(int healAmount)
    {
        storedHealthKits++;
        healAmountPerKit = healAmount;
        Debug.Log("Botiquín recogido. Total: " + storedHealthKits);
    }

    private void Update()
    {
        if (Keyboard.current.hKey.wasPressedThisFrame && storedHealthKits > 0)
        {
            UseHealthKit();
        }
    }

    private void UseHealthKit()
    {
        if (playerHealth != null)
        {
            playerHealth.Heal(healAmountPerKit);
            storedHealthKits--;
            Debug.Log("Usaste un botiquín. Quedan: " + storedHealthKits);
        }
    }
}
